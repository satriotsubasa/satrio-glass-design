{
  "name": "@satrio/glass-design",
  "version": "0.1.0",
  "type": "module",
  "description": "satrio glass — the shared design language: tokens, materials, motion, components, and the policy tests that enforce them.",
  "repository": "github:satriotsubasa/satrio-glass-design",
  "files": ["src", "!src/docs", "!src/**/*.test.ts", "!src/**/*.test.tsx", "!src/test"],
  "exports": {
    ".": "./src/index.ts",
    "./fonts": "./src/fonts.ts",
    "./testing": "./src/testing/index.ts",
    "./toast": "./src/components/common/toast.ts",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/global.css": "./src/styles/global.css",
    "./styles/brand-template.css": "./src/styles/brand-template.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "framer-motion": "^12.0.0",
    "@phosphor-icons/react": "^2.1.0",
    "vitest": ">=3.0.0"
  },
  "peerDependenciesMeta": { "vitest": { "optional": true } },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "react-remove-scroll": "^2.7.2",
    "react-hot-toast": "^2.6.0",
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8"
  },
  "devDependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "framer-motion": "^12.42.0",
    "@phosphor-icons/react": "^2.1.10",
    "typescript": "~5.9.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/node": "^24.13.2"
  }
}
