{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client", "vitest/globals", "node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@satrio/glass-design": ["./src/index.ts"],
      "@satrio/glass-design/fonts": ["./src/fonts.ts"],
      "@satrio/glass-design/testing": ["./src/testing/index.ts"],
      "@satrio/glass-design/toast": ["./src/components/common/toast.ts"]
    }
  },
  "include": ["src"]
}
